# Copy these into your hosting provider's environment settings (or export them in your shell).

# Password for the admin panel at /admin. Required in production.
ADMIN_PASSWORD=change-me

# Public address customers will reach. QR codes encode this URL, so set it
# before printing. No trailing slash.
PUBLIC_URL=https://menu.example.com

# Long random string used to sign admin sessions. Keeps admins signed in across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port to listen on (default 3000).
PORT=3000

# Where the SQLite database is stored (default ./data).
DATA_DIR=./data

# Set to 1 (or true) when running behind a reverse proxy / load balancer that sets X-Forwarded-* headers.
TRUST_PROXY=
